class Auto:
    def __init__(self,marcaInicial, colorInicial, kilometrajeInicial):
        self.marca = marcaInicial
        self.color = colorInicial
        self.km = kilometrajeInicial
    def mostrar (self):
        print("Marca:", self.marca)
        print("Color: ", self.color)
        print("KM: ", self.km)

objetoJeep = Auto("Ford", "Rojo", 5000)

objetoJeep.mostrar()

